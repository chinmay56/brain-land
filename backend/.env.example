# Copy to backend/.env and fill in. Never commit the filled-in copy.

# FastAPI Server
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Sarvam AI Vision Model Credentials
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_API_URL=https://api.sarvam.ai/v1/vision

# Supabase Server-Side Configuration
# The service-role key bypasses row-level security. Server-side only: it must
# never be shipped to the browser or committed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo accounts created by `python scripts/seed_officer.py`.
# Officer accounts cannot be self-registered — signup always yields CITIZEN —
# so this script is the only way to get one.
DEMO_OFFICER_EMAIL=officer@example.gov.in
DEMO_OFFICER_PASSWORD=choose-a-strong-password
DEMO_OFFICER_NAME=Revenue Officer Name
DEMO_OFFICER_DISTRICT=Pune
DEMO_OFFICER_TEHSIL=Haveli
DEMO_CITIZEN_EMAIL=citizen@example.in
DEMO_CITIZEN_PASSWORD=choose-a-strong-password
